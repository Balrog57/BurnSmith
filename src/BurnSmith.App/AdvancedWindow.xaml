<Window x:Class="BurnSmith.App.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres avancés" Width="640" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24,16,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <!-- Sortie: shared with the main window's list; DVDFab layout, label left, control right -->
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Separator VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Sortie" FontSize="16" Margin="16,0"/>
          <Separator Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock x:Name="TreatLabel" Grid.Row="2" Text="Mode de traitement :" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,0"/>
          <ComboBox x:Name="TreatBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,8,0,0" SelectionChanged="OnQuality"/>
          <TextBlock Text="Nom de volume :" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,0"/>
          <TextBox x:Name="VolumeBox" Grid.Column="1" MaxLength="32" Margin="0,8,0,0"/>
          <TextBlock Grid.Row="1" Text="Sortie :" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,0"/>
          <ComboBox x:Name="OutputBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,8,0,0" SelectionChanged="OnRefresh"/>
          <TextBlock x:Name="QualityLabel" Grid.Row="3" Text="Qualité vidéo :" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,0"/>
          <ComboBox x:Name="QualityBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,8,0,0" SelectionChanged="OnQuality"/>
          <TextBlock x:Name="SizeText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="10,8,0,0"/>
          <Grid x:Name="RatePanel" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
            <TextBox x:Name="RateBox" MaxLength="5" TextChanged="OnRefresh"/>
            <TextBlock Text="Kbps" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.5" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
        <TextBlock x:Name="TreatNote" TextWrapping="Wrap" Opacity="0.65" Margin="0,12,0,0"
                   Text="REMARQUE : Passthrough copie la vidéo telle quelle (sources HEVC 2160p seulement, HDR10 et Dolby Vision gardés). Conversion la refait en HEVC 10 bits 2160p : le HDR10 est gardé, d'un Dolby Vision il ne reste que la couche HDR10."/>

        <!-- DVD only: the TV standard and the picture shape of the titles -->
        <StackPanel x:Name="DvdPanel">
          <Grid Margin="0,22,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Separator VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Propriétés du DVD" FontSize="16" Margin="16,0"/>
            <Separator Grid.Column="2" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Standard TV :" HorizontalAlignment="Right" Margin="0,8,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <RadioButton x:Name="TvNtsc" GroupName="tv" Content="NTSC" Width="90"/>
              <RadioButton x:Name="TvPal" GroupName="tv" Content="PAL" Width="90"/>
              <RadioButton x:Name="TvAuto" GroupName="tv" Content="Comme la 1re vidéo" ToolTip="PAL pour une vidéo à 25 / 50 i/s, sinon NTSC"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Rapport d'aspect :" HorizontalAlignment="Right" Margin="0,8,12,0"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
              <RadioButton x:Name="Wide" GroupName="aspect" Content="16:9" Width="90"/>
              <RadioButton x:Name="Narrow" GroupName="aspect" Content="4:3" ToolTip="Pour une source en 4:3 (vieille série, VHS) : sans bandes noires sur les côtés. Le menu reste en 16:9."/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Blu-ray only: the menu as the BD-J program or as native HDMV navigation -->
        <StackPanel x:Name="MenuKindPanel">
          <Grid Margin="0,22,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Separator VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Type de menu" FontSize="16" Margin="16,0"/>
            <Separator Grid.Column="2" VerticalAlignment="Center"/>
          </Grid>
          <RadioButton x:Name="MenuBdj" GroupName="menukind" Content="BD-J : toutes les fonctions du menu" Margin="0,8,0,0"
                       ToolTip="Le menu est un petit programme Java que la platine exécute : fond animé, menu pop-up, langue changée pendant le film."/>
          <RadioButton x:Name="MenuHdmv" GroupName="menukind" Content="HDMV : menu natif, fonctions limitées" Margin="0,10,0,0"
                       ToolTip="Le menu est fait des commandes de base du Blu-ray, sans Java : toutes les platines les lisent."/>
          <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="28,4,0,0"
                     Text="En HDMV : pages fixes (pas de fond animé), pas de menu pop-up ; la langue et les sous-titres choisis au menu s'appliquent au lancement d'un titre. L'éditeur de menu grise ce qui n'est pas pris en charge."/>
        </StackPanel>

        <!-- Mode de lecture: what the menu does when a title ends -->
        <StackPanel x:Name="PlaybackPanel">
          <Grid Margin="0,22,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Separator VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Mode de lecture" FontSize="16" Margin="16,0"/>
            <Separator Grid.Column="2" VerticalAlignment="Center"/>
          </Grid>
          <RadioButton x:Name="Mode0" GroupName="play" Content="Démarrer depuis le menu et lire tous les titres à la suite" Margin="0,8,0,0" Checked="OnMode"/>
          <CheckBox x:Name="Rewind0" Content="Rembobiner à la fin" Margin="28,4,0,0" ToolTip="À la fin, revenir au menu. Sinon l'écran reste noir."/>
          <RadioButton x:Name="Mode1" GroupName="play" Content="Démarrer au premier titre et tout lire à la suite" Margin="0,10,0,0" Checked="OnMode"/>
          <CheckBox x:Name="Rewind1" Content="Rembobiner à la fin" Margin="28,4,0,0" ToolTip="À la fin, relancer le premier titre. Sinon l'écran reste noir."/>
          <RadioButton x:Name="Mode2" GroupName="play" Content="Retourner au menu si la lecture du titre sélectionné est terminée" Margin="0,10,0,0" Checked="OnMode"/>
        </StackPanel>

        <!-- the text subtitles kept on the disc: font, size, colour, height (SubtitleStyle) -->
        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Separator VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Sous-titres en texte" FontSize="16" Margin="16,0"/>
          <Separator Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,0"
                   Text="Pour les sous-titres en texte (SRT, ASS…) gardés sur le disque. Ceux en images (PGS, VobSub) gardent leur aspect ; sur un DVD, la couleur vaut pour tous les sous-titres. Le décalage d'un sous-titre se règle dans la liste des vidéos, colonne Sous-titres."/>
        <TextBlock Text="Police" Style="{StaticResource Label}"/>
        <ComboBox x:Name="SubFontBox" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Taille" Style="{StaticResource Label}"/>
        <ComboBox x:Name="SubSizeBox" HorizontalAlignment="Stretch" ItemStringFormat="{}{0} %"/>
        <TextBlock Text="Couleur" Style="{StaticResource Label}"/>
        <ComboBox x:Name="SubColorBox" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Hauteur dans l'image (à gauche : en bas, à droite : en haut)" Style="{StaticResource Label}"/>
        <Slider x:Name="SubPosSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" AutomationProperties.Name="Hauteur des sous-titres"/>

        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Separator VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Autres réglages" FontSize="16" Margin="16,0"/>
          <Separator Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="Langue de BurnSmith / Language" Style="{StaticResource Label}"/>
        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" ToolTip="La langue des fenêtres de BurnSmith. Celle du menu du disque se règle dans l'éditeur de menu."/>
        <TextBlock Text="Un chapitre toutes les" Style="{StaticResource Label}"/>
        <ComboBox x:Name="ChapterBox" HorizontalAlignment="Stretch" ItemStringFormat="{}{0} min"/>
        <CheckBox x:Name="GpuBox" Content="Convertir avec la carte graphique NVIDIA" Margin="0,12,0,0"
                  ToolTip="Plusieurs fois plus rapide. Le processeur reste utilisé quand la carte ne peut pas : pas de carte NVIDIA, 1080i, 4K HDR10+ ou Dolby Vision, MPEG-2 du DVD (la carte lit alors la vidéo)."/>
        <StackPanel x:Name="EncodePanel">
          <TextBlock x:Name="ModeLabel" Text="Mode vidéo" Style="{StaticResource Label}"/>
          <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch"/>
          <TextBlock Text="Images par seconde" Style="{StaticResource Label}"/>
          <ComboBox x:Name="FpsBox" HorizontalAlignment="Stretch" SelectionChanged="OnRefresh"
                    ToolTip="Le 1080p n'a 25 et 29,97 qu'en entrelacé, le 720p n'a que 50 et 59,94 : une autre cadence y est ramenée à la plus proche."/>
          <TextBlock Text="Vitesse de conversion (processeur)" Style="{StaticResource Label}"/>
          <ComboBox x:Name="SpeedBox" HorizontalAlignment="Stretch"/>
          <CheckBox x:Name="LosslessBox" Content="Son sans perte" Margin="0,12,0,0" Click="OnRefresh"
                    ToolTip="Garde le son sans perte du fichier au lieu de le refaire en AC-3 : le TrueHD tel quel (avec le cœur AC-3 qu'un disque demande), le FLAC et le PCM en LPCM. Le DTS-HD est toujours copié tel quel. Prend plus de place sur le disque."/>
          <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,12,0,0"
                     Text="« Adapter au disque » garde la vidéo telle quelle tant qu'elle tient sur le support, sinon la refait au débit qui remplit le disque. « Identique à la source » copie la vidéo si elle est déjà en H.264 1080p à 23,976 / 24 / 25 i/s, sinon la refait à qualité constante."/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="OK" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk" Style="{StaticResource Primary}"/>
      <Button Content="Annuler" IsCancel="True" MinWidth="90"/>
    </StackPanel>
  </Grid>
</Window>
