<Window x:Class="BurnSmith.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BurnSmith - Créateur" Width="1060" Height="900" MinWidth="940" MinHeight="840"
        Background="#1F1F1F" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Margin" Value="0,14,0,4"/>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="110"/>
    </Grid.RowDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton x:Name="KindDvd" Content="DVD" Tag="dvd" Style="{StaticResource Seg}" GroupName="kind" Checked="OnKind"/>
        <RadioButton x:Name="KindBd" Content="Blu-ray" Tag="bd" Style="{StaticResource Seg}" GroupName="kind" Checked="OnKind"/>
        <RadioButton x:Name="KindUhd" Content="Blu-ray 4K" Tag="uhd" Style="{StaticResource Seg}" GroupName="kind" Checked="OnKind"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Créateur" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Une vidéo, un menu, un disque : DVD, Blu-ray ou Blu-ray 4K." Opacity="0.65"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="Source" FontSize="16" FontWeight="SemiBold"/>
          <StackPanel x:Name="NoSource" Margin="0,16,0,0">
            <TextBlock Text="Glissez une vidéo ici, ou" Opacity="0.65"/>
            <Button Content="Ouvrir une vidéo…" Click="OnOpen" Margin="0,10,0,0"/>
          </StackPanel>
          <StackPanel x:Name="SourceInfo" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="SrcName" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SrcVideo" Opacity="0.8" Margin="0,6,0,0"/>
            <TextBlock x:Name="SrcAudio" Opacity="0.8"/>
            <Button Content="Changer…" Click="OnOpen" Margin="0,12,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Text="Disque" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Nom du volume" Style="{StaticResource Caption}"/>
          <TextBox x:Name="LabelBox" Text="MON_DISQUE" MaxLength="32" PreviewTextInput="OnLabelTyped"/>
          <TextBlock Text="Support" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="CapacityBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged"/>
          <TextBlock Text="Un chapitre toutes les" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="ChapterBox" HorizontalAlignment="Stretch" ItemStringFormat="{}{0} min" SelectionChanged="OnChanged"/>
          <CheckBox x:Name="MenuCheck" Content="Créer un menu" IsChecked="True" Margin="0,16,0,0" Checked="OnMenuToggle" Unchecked="OnMenuToggle"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="MenuButton" Content="Modifier le menu…" Click="OnEditMenu"/>
            <TextBlock x:Name="MenuName" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.65"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,22,0,0">
      <DockPanel>
        <TextBlock x:Name="CapText" DockPanel.Dock="Right"/>
        <TextBlock Text="Espace utilisé" Opacity="0.65"/>
      </DockPanel>
      <ProgressBar x:Name="CapBar" Height="10" Maximum="100" Margin="0,6,0,0"/>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,22,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Dossier de sortie (BDMV ou VIDEO_TS y sera créé)" Opacity="0.65" Margin="0,0,0,4"/>
        <TextBox x:Name="OutBox" PreviewTextInput="OnOutTyped"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Parcourir…" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="OnBrowseOut"/>
    </Grid>

    <DockPanel Grid.Row="4" Margin="0,22,0,0">
      <Button x:Name="StartButton" DockPanel.Dock="Right" Content="Démarrer" Style="{DynamicResource AccentButtonStyle}"
              MinWidth="160" Padding="24,10" FontSize="16" Click="OnStart"/>
      <Button x:Name="BurnButton" DockPanel.Dock="Right" Content="Graver…" IsEnabled="False" Margin="0,0,12,0" Padding="20,10" FontSize="16" Click="OnBurn"
              ToolTip="Grave le dernier disque créé (une image ISO est créée au besoin)"/>
      <ComboBox x:Name="DriveBox" DockPanel.Dock="Right" MinWidth="80" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Graveur"/>
      <CheckBox x:Name="IsoCheck" DockPanel.Dock="Left" Content="Créer aussi une image ISO" VerticalAlignment="Center" Margin="0,0,24,0"/>
      <ProgressBar x:Name="Busy" Visibility="Hidden" VerticalAlignment="Center" Margin="0,0,24,0"/>
    </DockPanel>

    <TextBox x:Name="Log" Grid.Row="5" Margin="0,16,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
  </Grid>
</Window>
