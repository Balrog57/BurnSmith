<Window x:Class="BurnSmith.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BurnSmith" Width="1280" Height="800" MinWidth="1140" MinHeight="640"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,16"/>
    </Style>
    <!-- a column header: its left edge is a thin separator, as in DVDFab's table -->
    <Style x:Key="Col" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
      <Setter Property="Padding" Value="10,2,0,2"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Drop" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <!-- the text is cut with an ellipsis when the column is narrow, the arrow stays on the right -->
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="▾" Margin="8,0,0,0"/>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- same proportions as the header of the list: the name and the two track columns share what is left, the others are fixed -->
    <DataTemplate x:Key="FileRow">
      <Grid Height="42">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="90"/>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="84"/>
          <ColumnDefinition Width="1.2*" MinWidth="100"/>
          <ColumnDefinition Width="1.2*" MinWidth="100"/>
          <ColumnDefinition Width="124"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Shown}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" Text="{Binding DurationText}" ToolTip="{Binding DurationTip}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Hdr}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="3" Style="{StaticResource Drop}" Content="{Binding AudioText}" ToolTip="Pistes audio gardées" Click="OnAudioMenu"/>
        <Button Grid.Column="4" Style="{StaticResource Drop}" Content="{Binding SubText}" ToolTip="Sous-titres gardés" Click="OnSubMenu"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="Prévisualisation (lecteur par défaut)" Click="OnRowPlay"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE70F;" ToolTip="Éditer : rogner, effets, filigrane, sous-titres, chapitres" Click="OnRowEdit"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE712;" ToolTip="Ordre, bonus, couper en deux titres, fusionner" Click="OnRowMore"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Supprimer le titre" Click="OnRowRemove"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{StaticResource GlowBrush}">
    <Grid Margin="28,22,28,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- title bar: the logo, then the disc tools (burn an image, erase) and the project buttons -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BurnButton" IsEnabled="False" Click="OnBurnIso" Padding="14,8" Margin="0,0,8,0" ToolTip="Grave une image ISO existante sur le disque du graveur choisi">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74E;" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Graver une image"/>
            </StackPanel>
          </Button>
          <Button x:Name="EraseButton" IsEnabled="False" Click="OnErase" Padding="14,8" Margin="0,0,16,0" ToolTip="Efface un disque réinscriptible (BD-RE, DVD±RW)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE894;" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Effacer un disque"/>
            </StackPanel>
          </Button>
          <Button x:Name="ModeButton" Style="{StaticResource Primary}" Padding="18,8" Margin="0,0,8,0" Click="OnModeClick" ToolTip="Type de disque">
            <Button.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem Header="Blu-ray" Tag="bd" Click="OnMode"/>
                <MenuItem Header="Blu-ray 4K" Tag="uhd" Click="OnMode"/>
                <MenuItem x:Name="DvdItem" Header="DVD" Tag="dvd" Click="OnMode" ToolTipService.ShowOnDisabled="True"/>
              </ContextMenu>
            </Button.ContextMenu>
            <TextBlock><Run x:Name="ModeText" Text="Blu-ray"/><Run Text="   ▾"/></TextBlock>
          </Button>
          <Button Content="+  Ajouter une source" Padding="18,8" Click="OnOpen"/>
        </StackPanel>
        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
          <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="BurnSmith" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Créateur de disques Blu-ray, Blu-ray 4K et DVD" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="240"/>
          </Grid.ColumnDefinitions>

          <!-- the project: poster, title, size -->
          <StackPanel Width="170" Margin="0,0,16,0">
            <Border Width="170" Height="96" Background="{StaticResource BgBrush}" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left">
              <Image x:Name="Poster" Stretch="UniformToFill"/>
            </Border>
            <TextBlock x:Name="ProjectTitle" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProjectInfo" Opacity="0.6" Margin="0,2,0,0"/>
          </StackPanel>

          <!-- the videos: fits the width of the window, no side scrolling (a long list scrolls down) -->
          <Grid Grid.Column="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="90"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="1.2*" MinWidth="100"/>
                <ColumnDefinition Width="1.2*" MinWidth="100"/>
                <ColumnDefinition Width="124"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Nom" Style="{StaticResource Head}"/>
              <Border Grid.Column="1" Style="{StaticResource Col}"><TextBlock Text="Durée" Style="{StaticResource Head}"/></Border>
              <Border Grid.Column="2" Style="{StaticResource Col}"><TextBlock Text="HDR" Style="{StaticResource Head}"/></Border>
              <Border Grid.Column="3" Style="{StaticResource Col}"><TextBlock Text="Audio" Style="{StaticResource Head}"/></Border>
              <Border Grid.Column="4" Style="{StaticResource Col}"><TextBlock Text="Sous-titres" Style="{StaticResource Head}"/></Border>
            </Grid>
            <ItemsControl x:Name="TitleList" ItemTemplate="{StaticResource FileRow}"/>
            </DockPanel>
            </ScrollViewer>
            <StackPanel x:Name="NoSource" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Glissez ici une ou plusieurs vidéos (pour une série : tous les épisodes)." Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="20,0"/>
              <Button Content="+  Ajouter une source" Click="OnOpen" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="18,8"/>
            </StackPanel>
          </Grid>

          <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="{StaticResource Icons}" FontSize="26" Opacity="0.5"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <!-- the output: disc, size, menu, advanced; the menu picture is the part that shrinks when the window is low -->
          <Border Grid.Column="3" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Sortie" Style="{StaticResource Head}"/>
                <ComboBox x:Name="CapacityBox" HorizontalAlignment="Stretch" Margin="0,4,0,0" SelectionChanged="OnChanged"/>
                <TextBlock x:Name="CapText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <ProgressBar x:Name="CapBar" Height="8" Maximum="100" Margin="0,6,0,0"/>
                <Separator Margin="0,14"/>
              </StackPanel>
              <StackPanel Grid.Row="1">
                <DockPanel>
                  <CheckBox x:Name="MenuCheck" DockPanel.Dock="Right" Content="Menu" IsChecked="True" Checked="OnMenuToggle" Unchecked="OnMenuToggle" MinWidth="0"/>
                  <TextBlock Text="Menu du disque" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="MenuName" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Viewbox Grid.Row="2" Margin="0,6,0,0" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Width="160" Height="90" Background="{StaticResource BgBrush}" CornerRadius="8" ClipToBounds="True">
                  <Image x:Name="MenuThumb" Stretch="UniformToFill"/>
                </Border>
              </Viewbox>
              <StackPanel Grid.Row="3">
                <Button x:Name="MenuButton" Content="Paramètres de menu" Click="OnEditMenu" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                <Button Content="Paramètres avancés" Click="OnAdvanced" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid x:Name="ProgressPanel" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" MaxWidth="460" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <ProgressBar x:Name="Busy" Grid.Column="1" Maximum="100" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" Grid.Column="2" Content="Annuler" Margin="16,0,0,0" Click="OnCancel"
                ToolTip="Arrête après l'étape en cours ; pendant l'écriture du disque, la gravure s'arrête aussitôt"/>
      </Grid>

      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Enregistrer vers :" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.75"/>
        <TextBox x:Name="OutBox" Grid.Column="1" VerticalAlignment="Center" PreviewTextInput="OnOutTyped" TextChanged="OnOutChanged"
                 ToolTip="Dossier du disque : BDMV (ou VIDEO_TS) y est créé"/>
        <TextBlock x:Name="FreeText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6"/>
        <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE8B7;" Margin="6,0,0,0" Width="38" Height="34" Click="OnBrowseOut" ToolTip="Choisir le dossier"/>
        <ToggleButton x:Name="IsoCheck" Grid.Column="4" Content="ISO" Margin="10,0,0,0" Padding="16,8" ToolTip="Créer aussi une image ISO (UDF) à côté du dossier"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
          <ToggleButton x:Name="BurnCheck" Content="Graver" Padding="16,8" IsEnabled="False" ToolTip="Grave le disque sur le graveur choisi après la création (une ISO temporaire est utilisée)"/>
          <ComboBox x:Name="DriveBox" MinWidth="120" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Graveur">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock><Run Text="{Binding Letter, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}" Foreground="Gray"/></TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Button x:Name="StartButton" Style="{StaticResource Primary}" Grid.Column="6" Content="Démarrer" Margin="16,0,0,0"
                MinWidth="150" Padding="24,10" FontSize="16" FontWeight="SemiBold" Click="OnStart"/>
      </Grid>

      <Expander x:Name="LogExpander" Grid.Row="4" Header="Journal" Margin="0,10,0,0">
        <TextBox x:Name="Log" Height="100" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
      </Expander>
    </Grid>
  </Grid>
</Window>
