<Window x:Class="BurnSmith.App.MenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BurnSmith.App"
        Title="Menu du disque" Width="1320" Height="780" MinWidth="1100" MinHeight="680"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <local:ThumbConverter x:Key="Thumb"/>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Margin" Value="0,12,0,3"/>
    </Style>
    <Style x:Key="Swatch" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="DockPanel.Dock" Value="Left"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="310"/>
    </Grid.ColumnDefinitions>

    <TabControl>
      <TabItem Header="Modèles">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="Ajouter un dossier…" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnAddFolder"/>
          <ListBox x:Name="BuiltInList" SelectionChanged="OnPick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <Image Source="{Binding Thumbnail}" Width="170" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Design.Name}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Design.Category}" HorizontalAlignment="Center" Opacity="0.5" FontSize="11"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Mes modèles">
        <ListBox x:Name="CustomList" DisplayMemberPath="Name" SelectionChanged="OnPick"/>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Column="1" Margin="16,0">
      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="◀" Width="40" Click="OnPrev"/>
          <TextBlock x:Name="PageText" Margin="16,0" VerticalAlignment="Center"/>
          <Button Content="▶" Width="40" Click="OnNext"/>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock x:Name="Hint" DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,0"
                 Text="Cliquez dans l'aperçu : flèches et Entrée (ou la souris) parcourent le menu comme sur le disque."/>
      <ListBox x:Name="PageStrip" DockPanel.Dock="Bottom" Margin="0,10,0,0" MaxHeight="170" SelectionChanged="OnStripPick"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="112" Margin="2">
              <Image Source="{Binding Thumb}" Width="112" Height="63" Stretch="Uniform"/>
              <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="Stage" Background="Black" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Focusable="True" FocusVisualStyle="{x:Null}"
              PreviewKeyDown="OnStageKey" MouseDown="OnStageMouse">
        <Viewbox Stretch="Uniform">
          <Canvas x:Name="StageCanvas" Width="1920" Height="1080" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Viewbox>
      </Border>
    </DockPanel>

    <ScrollViewer x:Name="PropsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Props" Margin="0,0,8,0">
        <TextBlock Text="Titre" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton lecture" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding PlayLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton scènes" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding ScenesLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton accueil" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding HomeLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Mot « chapitre »" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding ChapterLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton « tout lire » (séries)" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding PlayAllLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Liste des épisodes (séries)" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding EpisodesLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton et page des bonus" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding BonusLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton réglages (audio / sous-titres)" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding SettingsLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Colonne audio" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding AudioLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Colonne sous-titres" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding SubtitlesLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Sous-titres désactivés" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding OffLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton retour" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding BackLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Bouton crédits" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding CreditsLabel, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Texte des crédits (une ligne par rangée ; vide = pas de page crédits)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Credits, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="Titre du disque par langue, Blu-ray (une ligne par langue, ex. fra: Mon disque)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        <TextBox Text="{Binding TitlesByLanguage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto"/>

        <CheckBox Content="Menu animé : une vidéo tourne en boucle derrière les boutons" IsChecked="{Binding Loop}" Margin="0,16,0,0"/>
        <DockPanel Margin="0,4">
          <TextBlock Text="Début vidéo (s)" Width="120" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding LoopStart, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock Text="Vidéo du menu (vide = le premier film)" Style="{StaticResource Caption}"/>
        <DockPanel>
          <Button Content="…" Width="36" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnLoopFile"/>
          <TextBox Text="{Binding LoopFile, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <TextBlock Text="Musique du menu (vide = aucune ; avec un menu animé, remplace le son de la vidéo)" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,16,0,4"/>
        <DockPanel>
          <Button Content="…" Width="36" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnMusic"/>
          <TextBox Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,4">
          <TextBlock Text="Début musique (s)" Width="120" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding MusicStart, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,4">
          <TextBlock Text="Volume (%)" Width="120" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding MusicVolume, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,4">
          <TextBlock Text="Fondu (s)" Width="120" VerticalAlignment="Center" DockPanel.Dock="Left" ToolTip="Entrée au début de la boucle, sortie à sa fin (0 = aucun)"/>
          <TextBox Text="{Binding MusicFade, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,4">
          <TextBlock Text="Durée boucle (s)" Width="120" VerticalAlignment="Center" DockPanel.Dock="Left" ToolTip="Durée de la vidéo animée et de la musique avant qu'elles recommencent (5 à 120)"/>
          <TextBox Text="{Binding LoopSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock Text="Sans menu animé, la musique joue sur le menu fixe. Sur DVD elle repart quand on change de page ; sur Blu-ray elle continue." TextWrapping="Wrap" Opacity="0.65" Margin="0,4,0,0"/>
        <TextBlock x:Name="LookNote" Text="Ce modèle fixe l'apparence : police, couleurs, fond et libellés des boutons viennent de ses images (souvent en anglais)." TextWrapping="Wrap" Opacity="0.65" Margin="0,12,0,0" Visibility="Collapsed"/>
        <Button x:Name="Detach" Content="Composer à partir de ce fond" Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnDetach"
                ToolTip="Garde le fond de ce modèle (sans le copier) et ouvre la police, les boutons, la grille et les couleurs."/>
        <StackPanel x:Name="Look">
        <TextBlock Text="Police" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="FontBox" IsEditable="True" Text="{Binding Font, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Style des boutons" Style="{StaticResource Caption}"/>
        <ComboBox x:Name="StyleBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ButtonStyle}" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Grille des scènes (colonnes × lignes)" Style="{StaticResource Caption}"/>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="ColsBox" SelectedItem="{Binding Cols}" Width="70"/>
          <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center"/>
          <ComboBox x:Name="RowsBox" SelectedItem="{Binding Rows}" Width="70"/>
        </StackPanel>
        <CheckBox Content="Images des scènes" IsChecked="{Binding Thumbnails}" Margin="0,8,0,0"/>
        <CheckBox Content="Coins carrés" IsChecked="{Binding Square}" Margin="0,4,0,0"/>

        <TextBlock Text="Couleurs (#RRGGBB)" Style="{StaticResource Caption}"/>
        <DockPanel Margin="0,2">
          <Border Style="{StaticResource Swatch}" Background="{Binding Top}"/>
          <TextBlock Text="Fond haut" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding Top, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,2">
          <Border Style="{StaticResource Swatch}" Background="{Binding Bottom}"/>
          <TextBlock Text="Fond bas" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding Bottom, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,2">
          <Border Style="{StaticResource Swatch}" Background="{Binding TextColor}"/>
          <TextBlock Text="Texte" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,2">
          <Border Style="{StaticResource Swatch}" Background="{Binding Accent}"/>
          <TextBlock Text="Sélection" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,2">
          <Border Style="{StaticResource Swatch}" Background="{Binding CardFill}"/>
          <TextBlock Text="Cartes" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding CardFill, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel Margin="0,2">
          <Border Style="{StaticResource Swatch}" Background="{Binding Glow}"/>
          <TextBlock Text="Halo" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBox Text="{Binding Glow, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <TextBlock Text="Image de fond (bibliothèque)" Style="{StaticResource Caption}"/>
        <ListBox x:Name="BgList" Height="230" SelectionChanged="OnBgPick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <Image Source="{Binding Path, Converter={StaticResource Thumb}}" Width="96" Height="54" Stretch="UniformToFill" DockPanel.Dock="Left"/>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Source}" Opacity="0.55" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Margin="0,6,0,0">
          <Button x:Name="BgRemove" DockPanel.Dock="Right" Content="Retirer" Margin="4,0,0,0" IsEnabled="False" Click="OnBgRemove"/>
          <Button DockPanel.Dock="Right" Content="Aucune" Margin="8,0,0,0" Click="OnBgClear"/>
          <Button Content="Importer…" Click="OnBg"/>
        </DockPanel>
        <TextBlock Text="Assombrir le fond (%)" Style="{StaticResource Caption}"/>
        <Slider Minimum="0" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Dim}"/>
        </StackPanel>
        <CheckBox Content="Afficher l'aperçu du film" IsChecked="{Binding ShowPreview}" Margin="0,16,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Enregistrer le modèle…" Click="OnSave" Margin="0,0,16,0"/>
      <Button Content="OK" IsDefault="True" Style="{StaticResource Primary}" MinWidth="100" Margin="0,0,8,0" Click="OnOk"/>
      <Button Content="Annuler" IsCancel="True" MinWidth="100"/>
    </StackPanel>
  </Grid>
</Window>
