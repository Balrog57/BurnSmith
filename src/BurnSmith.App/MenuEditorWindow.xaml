<Window x:Class="BurnSmith.App.MenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BurnSmith.App"
        Title="Menu du disque" Width="1440" Height="820" MinWidth="1200" MinHeight="720"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner" PreviewKeyDown="OnWindowKey">
  <Window.Resources>
    <local:ThumbConverter x:Key="Thumb"/>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
    <Style x:Key="Swatch" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="DockPanel.Dock" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="Cliquer pour choisir une couleur dans la palette"/>
      <EventSetter Event="MouseLeftButtonDown" Handler="OnSwatchClick"/>
    </Style>
    <!-- a step of the bar, a family of templates: one of several, shown as a button that stays down -->
    <Style x:Key="Step" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
    <Style x:Key="AdvExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
      <Setter Property="Margin" Value="0,10,0,0"/>
      <Setter Property="Padding" Value="0,4,0,0"/>
      <Setter Property="IsExpanded" Value="False"/>
    </Style>
  </Window.Resources>

  <!-- Direct 3-step workflow (Modèle · Personnaliser · Aperçu), contextual element inspector on click, library drawer on demand -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="420"/>
    </Grid.ColumnDefinitions>

    <UniformGrid x:Name="StepBar" Grid.ColumnSpan="2" Columns="3" Margin="0,0,-8,14">
      <RadioButton Style="{StaticResource Step}" GroupName="step" Tag="0" Content="1 · Modèle" IsChecked="True" Checked="OnStep" ToolTip="Choisir l'habillage du menu parmi les modèles"/>
      <RadioButton Style="{StaticResource Step}" GroupName="step" Tag="1" Content="2 · Personnaliser" Checked="OnStep" ToolTip="Titre, fond, musique, présentation et éléments de chaque page"/>
      <RadioButton Style="{StaticResource Step}" GroupName="step" Tag="2" Content="3 · Aperçu" Checked="OnStep" ToolTip="Parcourir le menu comme avec la télécommande"/>
    </UniformGrid>

    <DockPanel Grid.Row="1" Margin="0,0,16,0">
      <WrapPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom" Margin="0,10,0,0">
        <Button x:Name="UndoButton" Content="↶ Annuler" Click="OnUndo" Padding="9,4" Margin="0,2,6,2" IsEnabled="False" ToolTip="Annuler la dernière modification (Ctrl+Z)"/>
        <Button x:Name="RedoButton" Content="↷ Rétablir" Click="OnRedo" Padding="9,4" Margin="0,2,12,2" IsEnabled="False" ToolTip="Rétablir ce qui a été annulé (Ctrl+Y)"/>
        <Button Content="◀" Width="36" Margin="0,2" Click="OnPrev" AutomationProperties.Name="Page précédente"/>
        <TextBlock x:Name="PageText" Margin="10,2" VerticalAlignment="Center"/>
        <Button Content="▶" Width="36" Margin="0,2,12,2" Click="OnNext" AutomationProperties.Name="Page suivante"/>
        <ToggleButton x:Name="SafeToggle" Content="Zone sûre" Padding="9,4" Margin="0,2,6,2" Checked="OnSafeToggle" Unchecked="OnSafeToggle"
                      ToolTip="Ce qu'un téléviseur peut couper : cadre plein = zone des titres (90 %), pointillés = zone d'action (93 %). En orange, un bouton ou un texte qui dépasse de la zone des titres"/>
        <ToggleButton x:Name="GridToggle" Content="Grille" Padding="9,4" Margin="0,2,6,2" Checked="OnGridToggle" Unchecked="OnGridToggle"
                      ToolTip="Affiche une grille magnétique (repères 40 px, aimantation 20 px ; maintenez Alt pour placer au pixel près)"/>
        <ToggleButton x:Name="ArrowsToggle" Content="Flèches" Padding="9,4" Margin="0,2,6,2" Checked="OnArrowsToggle" Unchecked="OnArrowsToggle"
                      ToolTip="Affiche les flèches de navigation télécommande et les alertes normatives sur la page"/>
        <Button x:Name="LayersBtn" Content="Calques…" Padding="9,4" Margin="0,2,6,2" Click="OnOpenLayersDrawer"
                ToolTip="Afficher et réordonner les calques de la page (ordre Z, visibilité, verrouillage)"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,6,2" VerticalAlignment="Center"
                    ToolTip="État affiché sur l'aperçu : Normal, Sélectionné ou Activé (appui sur OK)">
          <RadioButton x:Name="StateNormalRadio" Style="{StaticResource Step}" GroupName="btnState" Tag="normal" Content="Normal" Padding="7,4" Margin="0,0,2,0" Checked="OnPreviewStateChanged"/>
          <RadioButton x:Name="StateFocusRadio" Style="{StaticResource Step}" GroupName="btnState" Tag="focus" Content="Sélection" Padding="7,4" Margin="0,0,2,0" IsChecked="True" Checked="OnPreviewStateChanged"/>
          <RadioButton x:Name="StateActiveRadio" Style="{StaticResource Step}" GroupName="btnState" Tag="active" Content="Activé" Padding="7,4" Margin="0" Checked="OnPreviewStateChanged"/>
        </StackPanel>
        <Button x:Name="AddMenuButton" Content="+ Ajouter ▾" Padding="10,4" Margin="0,2" Click="OnAddMenuClick"
                ToolTip="Ajouter un texte, une image, un cadre, un bouton ou un sous-menu sur la page">
          <Button.ContextMenu>
            <ContextMenu Placement="Top">
              <MenuItem Header="+ Texte" Click="OnAddText"/>
              <MenuItem Header="+ Image" Click="OnAddImage"/>
              <MenuItem Header="+ Cadre" Click="OnAddBox"/>
              <MenuItem Header="+ Bouton" Click="OnAddButton"/>
              <MenuItem Header="Galerie de boutons…" Click="OnOpenBtnDrawer"/>
              <Separator/>
              <MenuItem Header="+ Sous-menu" Click="OnAddSubmenu"/>
              <MenuItem x:Name="RenameSubmenu" Header="Renommer le sous-menu" Click="OnRenameSubmenu" Visibility="Collapsed"/>
              <MenuItem x:Name="RemoveSubmenu" Header="Retirer le sous-menu" Click="OnRemoveSubmenu" Visibility="Collapsed"/>
              <Separator/>
              <MenuItem Header="Liens des flèches…" Click="OnDirectionLink"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </WrapPanel>
      <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="Hint" DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.65" Margin="0,6,0,0"/>
      <ListBox x:Name="PageStrip" DockPanel.Dock="Bottom" Margin="0,10,0,0" Height="96" SelectionChanged="OnStripPick"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="112" Margin="2">
              <Image Source="{Binding Thumb}" Width="112" Height="63" Stretch="Uniform"/>
              <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="Stage" Background="Black" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Focusable="True" FocusVisualStyle="{x:Null}"
              AllowDrop="True" PreviewKeyDown="OnStageKey" MouseDown="OnStageMouse" DragOver="OnStageDragOver" Drop="OnStageDrop">
        <Viewbox Stretch="Uniform">
          <Canvas x:Name="StageCanvas" Width="1920" Height="1080" Background="Transparent" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality"
                  MouseMove="OnCanvasMove" MouseLeftButtonUp="OnCanvasUp" LostMouseCapture="OnCanvasLost"/>
        </Viewbox>
      </Border>
    </DockPanel>

    <!-- one panel per step, no tab strip of its own: the bar above picks it -->
    <TabControl x:Name="Props" Grid.Row="1" Grid.Column="1">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <ContentPresenter ContentSource="SelectedContent"/>
        </ControlTemplate>
      </TabControl.Template>

      <!-- 1 · Modèle -->
      <TabItem>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Chercher :" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" TextChanged="OnSearch" AutomationProperties.Name="Chercher un modèle"
                     ToolTip="Un mot du nom ou de l'usage (mariage, série, voyage…) : la recherche porte sur tous les modèles"/>
          </DockPanel>
          <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-6,8">
            <Button Content="+ Page vierge" Click="OnQuickBlank" Margin="0,0,6,0" Padding="6,5" FontSize="12"
                    ToolTip="Partir d'une page libre personnalisable de zéro"/>
            <Button Content="Film minimal" Tag="Film minimal" Click="OnQuickTemplate" Margin="0,0,6,0" Padding="6,5" FontSize="12"
                    ToolTip="Modèle épuré pour un film"/>
            <Button Content="Série minimal" Tag="Série minimal" Click="OnQuickTemplate" Margin="0,0,6,0" Padding="6,5" FontSize="12"
                    ToolTip="Modèle épuré pour une saison / série"/>
          </UniformGrid>
          <WrapPanel x:Name="Families" DockPanel.Dock="Top" Margin="0,0,0,4"/>
          <Expander DockPanel.Dock="Bottom" Header="Options et import de modèles" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                          ToolTip="La galerie ne montre que les modèles dessinés pour cet écran ; un modèle livré dans les deux formes passe à l'autre version">
                <TextBlock Text="Écran :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="Shape169" Content="16:9" GroupName="shape" Style="{StaticResource Step}" Padding="10,4" Checked="OnShape"/>
                <RadioButton x:Name="Shape43" Content="4:3" GroupName="shape" Style="{StaticResource Step}" Padding="10,4" Checked="OnShape"/>
              </StackPanel>
              <Button Content="Ajouter un dossier de modèles…" HorizontalAlignment="Stretch" Click="OnAddFolder"
                      ToolTip="Un dossier de modèles DVDFab, Leawo, Yuhan ou DVDStyler : ils sont convertis et rangés avec les autres"/>
              <TextBlock x:Name="ConvertNote" Margin="0,4,0,0" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>
          </Expander>
          <Grid>
            <ListBox x:Name="BuiltInList" SelectionChanged="OnPick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2" ToolTip="{Binding Design.Name}">
                    <Grid>
                      <Viewbox Stretch="Uniform">
                        <Border Width="170" Height="96" Background="#22000000" CornerRadius="4">
                          <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}}" Stretch="Uniform"/>
                        </Border>
                      </Viewbox>
                      <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Click="OnStar" Cursor="Hand"
                              ToolTip="Favori : le modèle reste en tête de la galerie" AutomationProperties.Name="Favori">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border Background="#99000000" CornerRadius="3" Padding="4,0,4,1"><ContentPresenter/></Border>
                          </ControlTemplate>
                        </Button.Template>
                        <TextBlock FontSize="15" Foreground="Gold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="☆"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Favorite}" Value="True"><Setter Property="Text" Value="★"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Button>
                    </Grid>
                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel x:Name="MinePanel" Visibility="Collapsed">
              <TextBlock DockPanel.Dock="Top" Text="Les menus que vous enregistrez avec « Enregistrer le modèle… », en bas de la fenêtre." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="MineRenameBtn" Content="Renommer…" Click="OnMineRename" Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="MineDupBtn" Content="Dupliquer…" Click="OnMineDuplicate" Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="MineDelBtn" Content="Supprimer" Click="OnMineDelete" IsEnabled="False"/>
              </DockPanel>
              <ListBox x:Name="CustomList" SelectionChanged="OnPickMine" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2" ToolTip="{Binding Name}">
                      <Viewbox Stretch="Uniform">
                        <Border Width="170" Height="96" Background="#22000000" CornerRadius="4">
                          <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}}" Stretch="Uniform"/>
                        </Border>
                      </Viewbox>
                      <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- 2 · Personnaliser (réglages du menu · inspecteur contextuel · tiroir bibliothèque) -->
      <TabItem>
        <Grid>
          <!-- Vue A : réglages du menu (essentiel visible + accordéons avancés) -->
          <ScrollViewer x:Name="MenuSettingsPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,12">
              <TextBlock Text="Titre et langue" Style="{StaticResource Head}" Margin="0,0,0,6"/>
              <TextBlock Text="Titre du menu" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
              <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
              <StackPanel x:Name="ZonePanel"/>
              <TextBlock Text="Langue du menu" Style="{StaticResource Caption}"/>
              <ComboBox x:Name="LanguageBox" SelectionChanged="OnPickLanguage" DisplayMemberPath="Label" SelectedValuePath="Value" HorizontalAlignment="Stretch" AutomationProperties.Name="Langue du menu"
                        ToolTip="Tous les mots du menu en français ou en anglais. Un mot que vous avez écrit vous-même est gardé."/>

              <TextBlock Text="Fond et musique" Style="{StaticResource Head}"/>
              <WrapPanel Margin="0,0,0,4">
                <Button Content="Galerie de fonds…" Click="OnOpenBgDrawer" Margin="0,0,6,6"
                        ToolTip="Ouvre le tiroir des fonds fournis et de vos images importées"/>
                <Button Content="Importer…" Click="OnBg" Margin="0,0,6,6"/>
                <Button Content="Cette page…" Click="OnPageBg" Margin="0,0,6,6"
                        ToolTip="Une image de fond pour ce genre de page ; les autres gardent le fond du modèle"/>
                <Button x:Name="PageBgClear" Content="Fond commun" Click="OnPageBgClear" Margin="0,0,6,6"/>
                <Button Content="Aucun" Click="OnBgClear" Margin="0,0,0,6" ToolTip="Revient au dégradé de couleurs"/>
              </WrapPanel>
              <CheckBox x:Name="LoopBox" Content="Menu animé : vidéo en boucle derrière les boutons" Margin="0,4,0,0"
                        Checked="OnPageMediaChanged" Unchecked="OnPageMediaChanged"/>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Vidéo" Width="62" VerticalAlignment="Center" Opacity="0.7" DockPanel.Dock="Left"/>
                <Button Content="…" Width="36" Padding="0,4" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnLoopFile" AutomationProperties.Name="Choisir la vidéo du menu"/>
                <TextBox x:Name="LoopFileBox" TextChanged="OnPageMediaChanged" ToolTip="Vide = le premier film"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Musique" Width="62" VerticalAlignment="Center" Opacity="0.7" DockPanel.Dock="Left"/>
                <Button Content="…" Width="36" Padding="0,4" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnMusic" AutomationProperties.Name="Choisir la musique"/>
                <TextBox x:Name="MusicFileBox" TextChanged="OnPageMediaChanged" ToolTip="Vide = aucune musique"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Volume" Width="62" VerticalAlignment="Center" Opacity="0.7" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding Value, ElementName=MusicVolumeSlider, StringFormat={}{0:0} %}" Width="46" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnPageMediaChanged" AutomationProperties.Name="Volume de la musique"/>
              </DockPanel>
              <CheckBox x:Name="PageMediaScopeBox" Content="Appliquer vidéo/musique à cette page seulement" Margin="0,8,0,0"
                        Checked="OnPageMediaScopeChanged" Unchecked="OnPageMediaScopeChanged"
                        ToolTip="Cochez pour associer une vidéo animée ou une musique différente uniquement à la page affichée"/>

              <TextBlock Text="Présentation" Style="{StaticResource Head}"/>
              <TextBlock Text="Affichage des scènes" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
              <ComboBox x:Name="SceneModeBox" SelectionChanged="OnPickSceneMode" HorizontalAlignment="Stretch" AutomationProperties.Name="Affichage des scènes"
                        ToolTip="Choisit la mise en page des chapitres ou épisodes (grille avec vignettes, texte seul, liste ou accès direct).">
                <ComboBoxItem Content="Grille avec vignettes"/>
                <ComboBoxItem Content="Grille texte seul"/>
                <ComboBoxItem Content="Liste sans vignettes (selon le modèle)"/>
                <ComboBoxItem Content="Chapitres directement en menu principal"/>
              </ComboBox>
              <StackPanel x:Name="GridLook" Margin="0,6,0,0">
                <DockPanel Margin="0,2,0,0">
                  <TextBlock Text="Chapitres / épisodes par page" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="ColsBox" SelectedItem="{Binding Cols}" Width="62" AutomationProperties.Name="Colonnes"/>
                    <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RowsBox" SelectedItem="{Binding Rows}" Width="62" AutomationProperties.Name="Lignes"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
              <TextBlock x:Name="GridNote" Text="Ce modèle fixe lui-même le nombre de cases par page." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
              <Button x:Name="ConvertFreeButton" Content="Convertir cette page en composition libre" Click="OnConvertFree" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                      ToolTip="Transforme les boutons et zones du modèle sur cette page en éléments libres entièrement modifiables"/>
              <CheckBox x:Name="PopupBox" Content="Menu pop-up par-dessus le film (Blu-ray)" IsChecked="{Binding Popup}" Margin="0,8,0,0"
                        ToolTip="La touche Pop-up de la télécommande ouvre un petit menu sans arrêter le film"/>
              <TextBlock Text="Lecture du disque" Style="{StaticResource Caption}"/>
              <ComboBox x:Name="PlayModeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Lecture du disque">
                <ComboBoxItem Content="Afficher le menu, puis lire toutes les vidéos à la suite"/>
                <ComboBoxItem Content="Lire la première vidéo dès l'insertion, puis les suivantes"/>
                <ComboBoxItem Content="Afficher le menu, y revenir à la fin de chaque vidéo"/>
              </ComboBox>

              <!-- Accordéons : tous les réglages avancés accessibles en un clic -->
              <Expander Header="Style et couleurs avancés" Style="{StaticResource AdvExpander}">
                <StackPanel Margin="0,6,0,4">
                  <TextBlock x:Name="LookNote" Text="Ce modèle fixe l'apparence : police, couleurs, fond et libellés des boutons viennent de ses images." TextWrapping="Wrap" Opacity="0.65" Visibility="Collapsed"/>
                  <Button x:Name="Detach" Content="Composer à partir de ce fond" Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnDetach"
                          ToolTip="Garde le fond de ce modèle (sans le copier) et ouvre la police, les boutons, la grille et les couleurs."/>
                  <StackPanel x:Name="Look">
                    <TextBlock Text="Police" Style="{StaticResource Caption}" Margin="0,2,0,3"/>
                    <ComboBox x:Name="FontBox" IsEditable="True" Text="{Binding Font, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Style des boutons" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="StyleBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ButtonStyle}" HorizontalAlignment="Stretch"/>
                    <CheckBox Content="Coins carrés" IsChecked="{Binding Square}" Margin="0,4,0,0"/>
                    <TextBlock Text="Surbrillance du bouton choisi" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="HlBox" SelectionChanged="OnPickHighlight" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                    <StackPanel x:Name="BdCursorPanel">
                      <TextBlock Text="Curseur animé BD-J" Style="{StaticResource Caption}"/>
                      <DockPanel>
                        <Button x:Name="CursorCustomBtn" Content="PNG…" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,4" Click="OnPickCursorFrames" Visibility="Collapsed"
                                ToolTip="Choisir plusieurs images PNG (2 ou plus) pour animer le curseur sur Blu-ray"/>
                        <ComboBox x:Name="CursorPresetBox" SelectionChanged="OnPickCursorPreset" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ToolTip="Curseur animé affiché sur le bouton sélectionné (Blu-ray BD-J)"/>
                      </DockPanel>
                    </StackPanel>
                    <TextBlock Text="Couleurs (#RRGGBB)" Style="{StaticResource Caption}"/>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding Top}"/>
                      <TextBlock Text="Fond haut" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding Top, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding Bottom}"/>
                      <TextBlock Text="Fond bas" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding Bottom, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding TextColor}"/>
                      <TextBlock Text="Texte" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding Accent}"/>
                      <TextBlock Text="Sélection" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding SelectionColor}"/>
                      <TextBlock Text="Sélection (2e)" Width="90" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding SelectionColor, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="Transparence de la sélection (%)" Style="{StaticResource Caption}"/>
                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SelectionOpacity}"/>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding CardFill}"/>
                      <TextBlock Text="Cartes" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding CardFill, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel Margin="0,2">
                      <Border Style="{StaticResource Swatch}" Background="{Binding Glow}"/>
                      <TextBlock Text="Halo" Width="80" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                      <TextBox Text="{Binding Glow, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="Assombrir le fond (%)" Style="{StaticResource Caption}"/>
                    <Slider Minimum="0" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Dim}"/>
                    <TextBlock Text="Angle du dégradé (°)" Style="{StaticResource Caption}"/>
                    <Slider Minimum="0" Maximum="360" TickFrequency="15" IsSnapToTickEnabled="True" Value="{Binding GradientAngle}"
                            ToolTip="Orientation du dégradé entre la couleur haute et la couleur basse (0° = horizontal, 90° = vertical)"/>
                  </StackPanel>
                  <TextBlock Text="Flouter l'image de fond" Style="{StaticResource Caption}"/>
                  <Slider Minimum="0" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding BackgroundBlur}" AutomationProperties.Name="Flouter l'image de fond"/>
                </StackPanel>
              </Expander>

              <Expander Header="Structure, pop-up et BD-J" Style="{StaticResource AdvExpander}">
                <StackPanel Margin="0,6,0,4">
                  <CheckBox Content="Aperçu du film sur le menu principal" IsChecked="{Binding ShowPreview}" Margin="0,0,0,4"/>
                  <CheckBox Content="Vignettes animées" IsChecked="{Binding AnimatedThumbs}" Margin="0,4,0,0"
                            ToolTip="Un extrait vidéo du chapitre ou de l'épisode tourne dans chaque vignette (DVD et Blu-ray)"/>
                  <CheckBox Content="Pas de menu principal : les chapitres d'abord" IsChecked="{Binding ScenesOnly}" Margin="0,4,0,0" ToolTip="La première page de chapitres ou d'épisodes sert de menu"/>
                  <CheckBox Content="Série : pas de case pour la première vidéo" IsChecked="{Binding SkipFirstScene}" Margin="0,4,0,0" ToolTip="« Tout lire » la joue"/>
                  <CheckBox Content="Page Bonus en texte, sans vignettes" IsChecked="{Binding BonusText}" Margin="0,4,0,0"/>
                  <StackPanel x:Name="PopupSettingsGroup">
                  <TextBlock Text="Fond sombre du pop-up BD-J" Style="{StaticResource Caption}"/>
                  <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding PopupShade}"
                          ToolTip="Augmente l’opacité du fond du pop-up pour améliorer la lisibilité du texte sur le film."/>
                  <StackPanel IsEnabled="{Binding IsChecked, ElementName=PopupBox}" Margin="0,4,0,0">
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Position du pop-up" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PopDockBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PopupLayout.Dock}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Style boutons pop-up" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PopLookBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PopupLayout.ButtonLook}"/>
                      </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                      <Border Style="{StaticResource Swatch}" Background="{Binding PopupLayout.Fill}"/>
                      <TextBlock Text="Fond pop-up" Width="88" VerticalAlignment="Center"/>
                      <TextBox Text="{Binding PopupLayout.Fill, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Hauteur barre pop-up" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <Slider Minimum="140" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding PopupLayout.BarHeight}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Largeur boutons pop-up" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <Slider Minimum="180" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding PopupLayout.ButtonWidth}"/>
                      </StackPanel>
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                      <CheckBox Content="Bouton Reprendre" IsChecked="{Binding PopupLayout.ShowResume}" Margin="0,2"/>
                      <CheckBox Content="Bouton Chapitres" IsChecked="{Binding PopupLayout.ShowChapters}" Margin="0,2"/>
                      <CheckBox Content="Bouton Réglages" IsChecked="{Binding PopupLayout.ShowSettings}" Margin="0,2"/>
                      <CheckBox Content="Bouton Menu" IsChecked="{Binding PopupLayout.ShowMainMenu}" Margin="0,2"/>
                    </UniformGrid>
                  </StackPanel>
                  <DockPanel Margin="0,8,0,0" IsEnabled="{Binding IsChecked, ElementName=PopupBox}">
                    <TextBlock Text="Bouton reprendre" Width="150" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBox Text="{Binding ResumeLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  <DockPanel Margin="0,4,0,0" IsEnabled="{Binding IsChecked, ElementName=PopupBox}">
                    <TextBlock Text="Bouton menu principal" Width="150" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBox Text="{Binding MainMenuLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  </StackPanel>
                  <StackPanel x:Name="SoundSettingsPanel" Margin="0,8,0,0">
                    <TextBlock Text="Bruitages des boutons (Blu-ray)" Style="{StaticResource Caption}" Margin="0,4,0,3"/>
                    <DockPanel>
                      <Button Content="🔊 Écouter" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,4" Click="OnPreviewSound"
                              ToolTip="Écouter un aperçu des bruitages télécommande sur ce PC"/>
                      <ComboBox x:Name="SoundPackBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnPickSoundPack"/>
                    </DockPanel>
                    <TextBlock Text="Volume des bruitages (%)" Style="{StaticResource Caption}"/>
                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Sounds.Volume}"/>
                    <StackPanel x:Name="SoundCustomPanel" Visibility="Collapsed" Margin="0,6,0,0">
                      <DockPanel Margin="0,2">
                        <Button Content="Déplacement…" Width="104" DockPanel.Dock="Left" Click="OnPickMoveWav"/>
                        <TextBox Text="{Binding Sounds.MoveWav, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"/>
                      </DockPanel>
                      <DockPanel Margin="0,4,0,0">
                        <Button Content="Validation…" Width="104" DockPanel.Dock="Left" Click="OnPickSelectWav"/>
                        <TextBox Text="{Binding Sounds.SelectWav, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"/>
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="BdOnlyStructurePanel">
                    <TextBlock Text="Fondu entre les pages BD-J (ms, 0 = aucun)" Style="{StaticResource Caption}"/>
                    <Slider Minimum="0" Maximum="500" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding PageFadeMs}"/>
                    <TextBlock Text="Luminosité des graphismes en HDR (nits, 203 = standard)" Style="{StaticResource Caption}"/>
                    <Slider Minimum="80" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding HdrGraphicsNits}"
                            ToolTip="Calibre la luminance des menus et du pop-up sur les téléviseurs HDR (203 nits = référence SDR-dans-HDR ITU-R BT.2408)."/>
                    <TextBlock Text="Titre du disque par langue, Blu-ray (ex. fra: Mon disque)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding TitlesByLanguage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <TextBlock Text="Page Crédits (une ligne par rangée, vide = aucune)" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  <TextBox Text="{Binding Credits, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Texte des crédits"/>
                  <TextBlock Text="La page Langues (audio et sous-titres) et la page Bonus se créent d'elles-mêmes quand le disque a plusieurs pistes ou des bonus." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Expander>

              <Expander Header="Réglages fins vidéo et musique" Style="{StaticResource AdvExpander}">
                <StackPanel Margin="0,6,0,4">
                  <DockPanel Margin="0,2">
                    <TextBlock Text="Début de la vidéo (s)" Width="170" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBox Text="{Binding LoopStart, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock Text="Début de la musique (s)" Width="170" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBox Text="{Binding MusicStart, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock Text="Fondu audio (s)" Width="170" VerticalAlignment="Center" DockPanel.Dock="Left" ToolTip="Entrée au début de la boucle, sortie à sa fin (0 = aucun)"/>
                    <TextBox Text="{Binding MusicFade, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock Text="Durée de la boucle (s)" Width="170" VerticalAlignment="Center" DockPanel.Dock="Left" ToolTip="5 à 300 s sur Blu-ray, 5 à 120 s sur DVD. 0 = la chanson entière."/>
                    <TextBox Text="{Binding LoopSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                  </DockPanel>
                  <TextBlock Text="0 pour la durée : la chanson entière. Sans menu animé, la musique joue sur le menu fixe. Sur DVD elle repart quand on change de page ; sur Blu-ray elle continue." TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
              </Expander>

              <Expander Header="Libellés des boutons et pages" Style="{StaticResource AdvExpander}">
                <StackPanel Margin="0,6,0,4">
                  <TextBlock Text="Bouton lecture" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                  <TextBox Text="{Binding PlayLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton chapitres" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding ScenesLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton accueil" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding HomeLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Mot « chapitre »" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding ChapterLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton « tout lire » (séries)" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding PlayAllLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Liste des épisodes (séries)" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding EpisodesLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Mot devant le résumé d'un épisode" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding OverviewLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton et page des bonus" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding BonusLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton réglages (audio / sous-titres)" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding SettingsLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Colonne audio" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding AudioLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Colonne sous-titres" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding SubtitlesLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Sous-titres désactivés" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding OffLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton retour" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding BackLabel, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bouton crédits" Style="{StaticResource Caption}"/>
                  <TextBox Text="{Binding CreditsLabel, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Expander>

              <Expander Header="Éléments et navigation personnalisés" Style="{StaticResource AdvExpander}">
                <StackPanel Margin="0,6,0,4">
                  <TextBlock Text="Cliquez un élément ci-dessous ou directement sur la page pour le modifier." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ListBox x:Name="ElemList" Height="96" SelectionChanged="OnElemPick"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="Galerie de boutons…" Click="OnOpenBtnDrawer" Margin="0,0,6,6"/>
                    <Button Content="Liens des flèches…" Click="OnDirectionLink" Margin="0,0,0,6"/>
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <!-- Vue B : inspecteur contextuel (affiché automatiquement quand un élément est sélectionné sur la scène) -->
          <ScrollViewer x:Name="ElementInspectorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,12">
              <DockPanel Margin="0,0,0,10">
                <Button Content="← Retour au menu" Click="OnBackToMenu" Padding="10,4" DockPanel.Dock="Left"/>
                <Button x:Name="ResetNativeBtn" Content="Réinitialiser" Click="OnResetNative" Padding="10,4" DockPanel.Dock="Right" Visibility="Collapsed"
                        ToolTip="Rétablir la position et le style d'origine de cet élément du modèle"/>
                <TextBlock Text="Élément sélectionné" Style="{StaticResource Head}" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Texte" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="ElemText" TextChanged="OnElemText"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Mène à" Width="80" VerticalAlignment="Center"/>
                <ComboBox x:Name="ElemTarget" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnElemPickEvent"/>
              </DockPanel>
              <CheckBox x:Name="ElemDefaultBtn" Content="Bouton sélectionné par défaut sur cette page" Margin="0,6,0,0"
                        Checked="OnDefaultBtnToggle" Unchecked="OnDefaultBtnToggle"
                        ToolTip="Ce bouton reçoit le focus dès l'ouverture de cette page sur le lecteur"/>
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Page" Width="80" VerticalAlignment="Center"/>
                <ComboBox x:Name="ElemPage" SelectionChanged="OnElemPickEvent"/>
              </DockPanel>
              <TextBlock Text="Taille du texte" Style="{StaticResource Caption}"/>
              <Slider x:Name="ElemSize" Minimum="12" Maximum="160" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
              <DockPanel Margin="0,4">
                <Border Style="{StaticResource Swatch}" Background="{Binding ElementName=ElemColor, Path=Text}"/>
                <TextBlock Text="Couleur" Width="76" VerticalAlignment="Center"/>
                <TextBox x:Name="ElemColor" TextChanged="OnElemText"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <Button Content="Image…" Width="96" DockPanel.Dock="Left" Click="OnElemImage"/>
                <TextBox x:Name="ElemImage" TextChanged="OnElemText" Margin="6,0,0,0"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <Button Content="Sélection…" Width="96" DockPanel.Dock="Left" Click="OnElemFocus" ToolTip="L'image que montre un bouton image quand il est sélectionné (vide = le cadre du thème)"/>
                <TextBox x:Name="ElemFocus" TextChanged="OnElemText" Margin="6,0,0,0"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0">
                <Button Content="Activée…" Width="96" DockPanel.Dock="Left" Click="OnElemActive" ToolTip="L'image que montre un bouton quand on appuie sur OK (vide = surbrillance sélectionnée)"/>
                <TextBox x:Name="ElemActive" TextChanged="OnElemText" Margin="6,0,0,0"/>
              </DockPanel>
              <TextBlock Text="Aligner / répartir (Maj+clic ou lasso pour grouper)" Style="{StaticResource Caption}"/>
              <UniformGrid Columns="8" Margin="0,2,0,6">
                <Button Content="⟸" Tag="left" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Aligner à gauche (marge sûre TV)"/>
                <Button Content="↔" Tag="center-h" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Centrer horizontalement"/>
                <Button Content="⟹" Tag="right" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Aligner à droite (marge sûre TV)"/>
                <Button Content="⟰" Tag="top" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Aligner en haut (marge sûre TV)"/>
                <Button Content="↕" Tag="center-v" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Centrer verticalement"/>
                <Button Content="⟱" Tag="bottom" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Aligner en bas (marge sûre TV)"/>
                <Button x:Name="DistHBtn" Content="⇹" Tag="dist-h" Click="OnElemAlignCanvas" Padding="0,4" Margin="0,0,4,0" ToolTip="Répartir horizontalement (3+ sélectionnés)"/>
                <Button x:Name="DistVBtn" Content="⇕" Tag="dist-v" Click="OnElemAlignCanvas" Padding="0,4" ToolTip="Répartir verticalement (3+ sélectionnés)"/>
              </UniformGrid>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                <Button x:Name="ElemCopy" Content="Dupliquer" Click="OnElemDuplicate" Margin="0,0,8,0"/>
                <Button x:Name="ElemDelBtn" Content="Supprimer" Click="OnElemDelete"/>
              </StackPanel>

              <Expander Header="Placement et style avancés" Style="{StaticResource AdvExpander}">
                <StackPanel Margin="0,6,0,4">
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Style" Width="80" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ElemLook" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnElemPickEvent"
                              ToolTip="L'apparence d'un bouton sans image (vide = celle du thème)"/>
                  </DockPanel>
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Alignement" Width="80" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ElemAlign" SelectionChanged="OnElemPickEvent"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="ElemBold" Content="Gras" Margin="0,0,12,0" Checked="OnElemToggle" Unchecked="OnElemToggle"/>
                    <CheckBox x:Name="ElemItalic" Content="Italique" Checked="OnElemToggle" Unchecked="OnElemToggle"/>
                  </StackPanel>
                  <CheckBox x:Name="ElemBehind" Content="Derrière les boutons (panneau, cadre)" Margin="0,4,0,0" Checked="OnElemToggle" Unchecked="OnElemToggle"/>
                  <TextBlock Text="Horizontal" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemX" Minimum="0" Maximum="1800" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Vertical" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemY" Minimum="0" Maximum="980" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Largeur" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemW" Minimum="40" Maximum="1920" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Hauteur" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemH" Minimum="20" Maximum="1080" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <DockPanel Margin="0,4">
                    <Border Style="{StaticResource Swatch}" Background="{Binding ElementName=ElemFill, Path=Text}"/>
                    <TextBlock Text="Remplissage" Width="76" VerticalAlignment="Center"/>
                    <TextBox x:Name="ElemFill" TextChanged="OnElemText"/>
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <Border Style="{StaticResource Swatch}" Background="{Binding ElementName=ElemBorder, Path=Text}"/>
                    <TextBlock Text="Bordure" Width="76" VerticalAlignment="Center"/>
                    <TextBox x:Name="ElemBorder" TextChanged="OnElemText"/>
                  </DockPanel>
                  <TextBlock Text="Épaisseur de bordure" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemBorderW" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Opacité du cadre (%)" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemOpacity" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Opacité du calque (%)" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemLayerOpacity" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Rotation (°)" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemRotation" Minimum="-180" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <DockPanel Margin="0,4">
                    <Border Style="{StaticResource Swatch}" Background="{Binding ElementName=ElemOutline, Path=Text}"/>
                    <TextBlock Text="Contour" Width="76" VerticalAlignment="Center"/>
                    <TextBox x:Name="ElemOutline" TextChanged="OnElemText"/>
                  </DockPanel>
                  <TextBlock Text="Épaisseur du contour" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemOutlineW" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <DockPanel Margin="0,4">
                    <Border Style="{StaticResource Swatch}" Background="{Binding ElementName=ElemShadow, Path=Text}"/>
                    <TextBlock Text="Ombre" Width="76" VerticalAlignment="Center"/>
                    <TextBox x:Name="ElemShadow" TextChanged="OnElemText" ToolTip="Couleur d'ombre (#000000), vide = aucune"/>
                  </DockPanel>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Flou d'ombre" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                      <Slider x:Name="ElemShadowBlur" Minimum="0" Maximum="24" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Décalage d'ombre" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                      <Slider x:Name="ElemShadowOffset" Minimum="-24" Maximum="24" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Flou d'image" Style="{StaticResource Caption}"/>
                  <Slider x:Name="ElemImageBlur" Minimum="0" Maximum="30" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnElemSlide"/>
                  <TextBlock Text="Navigation à la télécommande (Haut / Bas / Gauche / Droite)" Style="{StaticResource Caption}"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Haut" FontSize="11" Opacity="0.65"/>
                      <ComboBox x:Name="NavUpBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnNavDirPick"/>
                      <TextBlock Text="Gauche" FontSize="11" Opacity="0.65" Margin="0,6,0,0"/>
                      <ComboBox x:Name="NavLeftBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnNavDirPick"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Bas" FontSize="11" Opacity="0.65"/>
                      <ComboBox x:Name="NavDownBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnNavDirPick"/>
                      <TextBlock Text="Droite" FontSize="11" Opacity="0.65" Margin="0,6,0,0"/>
                      <ComboBox x:Name="NavRightBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnNavDirPick"/>
                    </StackPanel>
                  </Grid>
                  <Button Content="Recalculer automatiquement les flèches de la page" Click="OnAutoNavRelink" Margin="0,6,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <!-- Vue C : tiroir bibliothèque (fonds ou boutons, ouvert à la demande) -->
          <Border x:Name="LibraryDrawer" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="12">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="← Fermer" Click="OnCloseDrawer" Padding="10,4" DockPanel.Dock="Right"/>
                <TextBlock x:Name="DrawerTitle" Style="{StaticResource Head}" Margin="0" VerticalAlignment="Center"/>
              </DockPanel>

              <Grid>
                <!-- Tiroir fonds -->
                <DockPanel x:Name="BgDrawerPanel" Visibility="Collapsed">
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="BgRemove" DockPanel.Dock="Right" Content="Retirer" Margin="4,0,0,0" IsEnabled="False" Click="OnBgRemove"/>
                    <Button DockPanel.Dock="Right" Content="Aucun" Margin="8,0,0,0" Click="OnBgClear" ToolTip="Revient au dégradé de couleurs"/>
                    <Button Content="Importer…" Click="OnBg"/>
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Glissez un fond sur la page, ou double-cliquez." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ListBox x:Name="BgList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="OnBgPick"
                           PreviewMouseLeftButtonDown="OnLibraryDown" PreviewMouseMove="OnLibraryMove" MouseDoubleClick="OnBgDouble">
                    <ListBox.GroupStyle>
                      <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="2,10,0,4"/>
                          </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                      </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Viewbox Stretch="Uniform" ToolTip="{Binding Name}">
                          <Image Source="{Binding Path, Converter={StaticResource Thumb}}" Width="108" Height="61" Stretch="UniformToFill"/>
                        </Viewbox>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <!-- Tiroir boutons -->
                <DockPanel x:Name="BtnDrawerPanel" Visibility="Collapsed">
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="BtnRemove" DockPanel.Dock="Right" Content="Retirer" Margin="8,0,0,0" IsEnabled="False" Click="OnBtnRemove"/>
                    <Button Content="Importer…" Click="OnBtnImport" ToolTip="Une image de bouton, puis (au choix) celle qu'il montre quand il est sélectionné"/>
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Glissez un bouton sur la page, ou double-cliquez." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ListBox x:Name="BtnList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="OnBtnPick"
                           PreviewMouseLeftButtonDown="OnLibraryDown" PreviewMouseMove="OnLibraryMove" MouseDoubleClick="OnBtnDouble">
                    <ListBox.GroupStyle>
                      <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="2,10,0,4"/>
                          </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                      </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Viewbox Stretch="Uniform" ToolTip="{Binding Name}">
                          <Border Width="108" Height="61" Background="#22000000" CornerRadius="4">
                            <Image Source="{Binding Sample}" Stretch="Uniform" Margin="3"/>
                          </Border>
                        </Viewbox>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <!-- Tiroir calques -->
                <DockPanel x:Name="LayersDrawerPanel" Visibility="Collapsed">
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Tout afficher" DockPanel.Dock="Right" Click="OnLayerShowAll" ToolTip="Réafficher tous les calques masqués de cette page"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="▲" Width="32" Margin="0,0,4,0" Click="OnLayerUp" ToolTip="Monter d'un cran"/>
                      <Button Content="▼" Width="32" Margin="0,0,4,0" Click="OnLayerDown" ToolTip="Descendre d'un cran"/>
                      <Button Content="⤒" Width="32" Margin="0,0,4,0" Click="OnLayerTop" ToolTip="Mettre tout devant"/>
                      <Button Content="⤓" Width="32" Click="OnLayerBottom" ToolTip="Envoyer à l'arrière"/>
                    </StackPanel>
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="De haut en bas (premier plan → arrière-plan). Cliquez un calque pour le sélectionner." Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ListBox x:Name="LayersList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="OnLayersListSelection">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Opacity="{Binding RowOpacity}" Margin="0,2">
                          <Button Content="🔒" Tag="{Binding Key}" DockPanel.Dock="Right" Padding="6,2" Margin="4,0,0,0" Opacity="{Binding LockOpacity}" Click="OnLayerToggleLock" ToolTip="Verrouiller / déverrouiller sur la scène"/>
                          <Button Content="👁" Tag="{Binding Key}" DockPanel.Dock="Right" Padding="6,2" Opacity="{Binding EyeOpacity}" Click="OnLayerToggleHide" ToolTip="Afficher / masquer ce calque"/>
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding KindTag}" FontSize="11" Opacity="0.65"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- 3 · Aperçu -->
      <TabItem>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="Télécommande" Style="{StaticResource Head}" Margin="0,0,0,6"/>
          <TextBlock Text="Le menu se parcourt ici comme sur le disque : les flèches passent d'un bouton à l'autre, OK ouvre la page ou dit ce que le disque lirait. Les flèches et Entrée du clavier font de même." TextWrapping="Wrap" Opacity="0.65"/>
          <UniformGrid Columns="3" Rows="3" Width="186" Height="150" Margin="0,16,0,0" HorizontalAlignment="Center">
            <Border/>
            <Button Content="▲" Tag="Up" Click="OnRemote" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Haut"/>
            <Border/>
            <Button Content="◀" Tag="Left" Click="OnRemote" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Gauche"/>
            <Button Content="OK" Tag="Enter" Click="OnRemote" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource Primary}"/>
            <Button Content="▶" Tag="Right" Click="OnRemote" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Droite"/>
            <Border/>
            <Button Content="▼" Tag="Down" Click="OnRemote" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Bas"/>
            <Border/>
          </UniformGrid>
          <Button Content="Menu principal" Tag="Menu" Click="OnRemote" HorizontalAlignment="Center" Padding="16,6" Margin="0,10,0,0" ToolTip="Revient à la première page, comme la touche Menu"/>
          <Button x:Name="PreviewPopupButton" Content="Pop-up" Tag="Popup" Click="OnRemote" HorizontalAlignment="Center" Padding="16,6" Margin="0,6,0,0"
                  ToolTip="Après avoir choisi un titre ou un chapitre, affiche son menu de lecture BD-J sur une image fixe."/>
          <Button x:Name="PreviewStartButton" Content="Démarrage du disque" Tag="Start" Click="OnRemote" HorizontalAlignment="Center" Padding="16,6" Margin="0,6,0,0"/>
          <Button x:Name="PreviewEndButton" Content="Fin du titre" Tag="End" Click="OnRemote" HorizontalAlignment="Center" Padding="16,6" Margin="0,6,0,0"/>
          <Button Content="Carte de navigation…" Click="OnNavigationMap" HorizontalAlignment="Center" Padding="16,6" Margin="0,10,0,0"
                  ToolTip="Affiche le graphe des pages, boutons, cibles et détecte les pages inaccessibles ou sans issue (BD-J, HDMV et DVD)."/>
          <TextBlock Text="Journal du simulateur" Style="{StaticResource Head}" Margin="0,14,0,4"/>
          <TextBox x:Name="SimLogBox" Height="110" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          <TextBlock Text="Sur un vrai lecteur" Style="{StaticResource Head}" Margin="0,14,0,6"/>
          <TextBlock TextWrapping="Wrap" Opacity="0.65"
                     Text="Pour voir le menu tourner pour de bon avant le vrai disque : validez avec OK, puis dans la fenêtre principale cochez « Essai » et « ISO » et cliquez Démarrer. Le disque d'essai est prêt en quelques minutes et s'ouvre dans VLC ou se grave sur un disque réinscriptible."/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Enregistrer le modèle…" Click="OnSave" Margin="0,0,16,0" ToolTip="Garde ce menu dans « Mes modèles », pour d'autres disques"/>
        <Button Content="OK" IsDefault="True" Style="{StaticResource Primary}" MinWidth="100" Margin="0,0,8,0" Click="OnOk"/>
        <Button Content="Annuler" IsCancel="True" MinWidth="100"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button x:Name="BackStep" Content="◂ Étape précédente" Click="OnBackStep" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="NextStep" Content="Étape suivante ▸" Click="OnNextStep"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
