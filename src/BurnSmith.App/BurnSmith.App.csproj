<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BurnSmith</AssemblyName>
    <RootNamespace>BurnSmith.App</RootNamespace>
    <!-- the release tag is v<Version>; the installer (installer\BurnSmith.iss) and the update check read it from the built exe -->
    <Version>0.5.0</Version>
    <!-- Application.ThemeMode (native Fluent theme) is still flagged experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BurnSmith.Core\BurnSmith.Core.csproj" />
    <ProjectReference Include="..\BurnSmith.Payload\BurnSmith.Payload.csproj" />
  </ItemGroup>

</Project>
