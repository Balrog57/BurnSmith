<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- BurnSmith red theme: dark neutral surfaces, crimson accent (after the dark, outlined look of the Balrog toolkit) -->
  <Color x:Key="AccentColor">#E23A4E</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#E23A4E"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5B70"/>
  <SolidColorBrush x:Key="AccentDeepBrush" Color="#A31630"/>
  <SolidColorBrush x:Key="AccentTintBrush" Color="#2B1118"/>
  <SolidColorBrush x:Key="BgBrush" Color="#141416"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#0E0E10"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C20"/>
  <SolidColorBrush x:Key="InsetBrush" Color="#16161A"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2B2B31"/>
  <SolidColorBrush x:Key="OutlineBrush" Color="#6B2432"/>

  <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B3122E" Offset="0"/>
    <GradientStop Color="#F0455B" Offset="1"/>
  </LinearGradientBrush>
  <!-- the soft red glow behind the content, as DVDFab has a purple one -->
  <RadialGradientBrush x:Key="GlowBrush" Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.95" RadiusY="0.8">
    <GradientStop Color="#4A101C" Offset="0"/>
    <GradientStop Color="#1E1015" Offset="0.45"/>
    <GradientStop Color="#141416" Offset="1"/>
  </RadialGradientBrush>

  <!-- Fluent's own accent brushes, so checkboxes, sliders, progress bars, focus lines and selections turn red too -->
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E23A4E"/>
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E23A4E" Opacity="0.9"/>
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E23A4E" Opacity="0.8"/>
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#C42A3F"/>
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7A8B"/>
  <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF7A8B"/>
  <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#F0586C"/>
  <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#E23A4E"/>
  <!-- and the system accent colours Fluent derives them from -->
  <Color x:Key="SystemAccentColor">#E23A4E</Color>
  <Color x:Key="SystemAccentColorPrimary">#E23A4E</Color>
  <Color x:Key="SystemAccentColorSecondary">#E23A4E</Color>
  <Color x:Key="SystemAccentColorTertiary">#E23A4E</Color>
  <Color x:Key="SystemAccentColorLight1">#FF5B70</Color>
  <Color x:Key="SystemAccentColorLight2">#FF5B70</Color>
  <Color x:Key="SystemAccentColorLight3">#FF7A8B</Color>
  <Color x:Key="SystemAccentColorDark1">#C42A3F</Color>
  <Color x:Key="SystemAccentColorDark2">#A31630</Color>
  <Color x:Key="SystemAccentColorDark3">#7E1124</Color>
  <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#E23A4E"/>
  <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#FF5B70"/>
  <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#FF5B70"/>
  <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#FF7A8B"/>
  <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#C42A3F"/>
  <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#A31630"/>
  <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#7E1124"/>
  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#E23A4E"/>
  <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#E23A4E"/>
  <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#E23A4E"/>

  <!-- buttons: rounded, dark, a red outline that lights up on hover; Primary = filled red gradient -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
    <Setter Property="Foreground" Value="#F2F2F4"/>
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="Veil" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="0.08"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="0.16"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- the Fluent check box and progress bar keep the Windows accent, so these two are redrawn in red -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#F2F2F4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <Border x:Name="Box" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource OutlineBrush}" Background="{StaticResource InsetBrush}"/>
              <Path x:Name="Tick" Data="M5,10 L9,14 L15,6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Background" Value="{StaticResource LineBrush}"/>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Height" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent" VerticalAlignment="Center">
            <!-- the filled part is a (red) progress bar on the same range: the Track's own left button would not draw here -->
            <ProgressBar Height="4" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Height="24" Background="Transparent"/></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Height="24" Background="Transparent"/></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="18" Height="18" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
    <Setter Property="Foreground" Value="#F2F2F4"/>
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="Veil" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Veil" Property="Opacity" Value="0.08"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
