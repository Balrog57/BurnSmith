<Window x:Class="BurnSmith.App.VideoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Éditer" Width="1080" Height="800" ResizeMode="CanResize" MinWidth="960" MinHeight="700"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Time" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="96"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="h:mm:ss (Entrée pour valider)"/>
    </Style>
  </Window.Resources>
  <!-- the video edit: the video before and after on the left, one tab per kind of change on the right -->
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="480"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Nom dans le menu" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="NameBox" Grid.Column="1"/>
      <TextBlock x:Name="SourceText" Grid.Column="2" Opacity="0.65" VerticalAlignment="Center" Margin="14,0,0,0"/>
    </Grid>

    <!-- the preview: a frame of the source, the same frame as it will be on the disc, and where in the video -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" VerticalAlignment="Top">
      <StackPanel>
        <!-- the source turned as the output will be, with the crop frame to drag on the Rogner tab; it also shows the video while it plays -->
        <Grid x:Name="SourceBox" Background="Black" Height="232" SizeChanged="OnSourceBoxSize">
          <Image x:Name="SourceImage" Stretch="Uniform">
            <Image.LayoutTransform>
              <TransformGroup><RotateTransform x:Name="SourceTurn"/><ScaleTransform x:Name="SourceFlip"/></TransformGroup>
            </Image.LayoutTransform>
          </Image>
          <Canvas x:Name="CropCanvas" Background="Transparent" ClipToBounds="True"
                  MouseLeftButtonDown="OnCropDown" MouseMove="OnCropMove" MouseLeftButtonUp="OnCropUp">
            <Path x:Name="CropShade" Fill="#99000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="CropRect" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"/>
          </Canvas>
        </Grid>
        <Grid Margin="0,6,0,6">
          <TextBlock Text="Aperçu de la sortie" Style="{StaticResource Label}"/>
          <TextBlock x:Name="TimeText" HorizontalAlignment="Right" Opacity="0.8"/>
        </Grid>
        <Border Background="Black" Height="232"><Image x:Name="OutputImage" Stretch="Uniform"/></Border>
        <!-- where in the video: the clips kept and the chapters under the slider, then the player's buttons -->
        <Slider x:Name="SeekSlider" Margin="0,8,0,0" ValueChanged="OnSeek" SmallChange="1" LargeChange="60"/>
        <Canvas x:Name="Marks" Height="8" ClipToBounds="True" Margin="5,2,5,0" SizeChanged="OnMarksSize" ToolTip="En couleur : les clips gardés ; les traits blancs : les chapitres"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="10 secondes plus tôt" Click="OnStep" Tag="-10"/>
          <Button x:Name="PlayButton" Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="Lecture / pause (sans le son)" Click="OnPlay"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="10 secondes plus tard" Click="OnStep" Tag="10"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Margin="14,0,0,0" ToolTip="Une seconde plus tôt" Click="OnStep" Tag="-1"/>
          <TextBox x:Name="PosBox" Style="{StaticResource Time}" PreviewKeyDown="OnPosKey" LostFocus="OnPosEdited"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE710;" ToolTip="Une seconde plus tard" Click="OnStep" Tag="1"/>
          <TextBlock x:Name="TotalText" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.8"/>
        </StackPanel>
        <TextBlock x:Name="PreviewError" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Grid.Column="2" SelectionChanged="OnTab">
      <!-- Rogner: turn, mirror, crop -->
      <TabItem Header="Rogner" Tag="crop">
        <DockPanel Margin="4,10,4,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Par défaut" Click="OnDefault" Tag="crop" Margin="0,0,8,0"/>
            <Button Content="Appliquer à tous" Click="OnApplyAll" Tag="crop"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="Rotation" Style="{StaticResource Section}" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="↺ 90°" ToolTip="Tourner à gauche" Click="OnRotate" Tag="-90" Margin="0,0,8,0"/>
                <Button Content="↻ 90°" ToolTip="Tourner à droite" Click="OnRotate" Tag="90" Margin="0,0,8,0"/>
                <ToggleButton x:Name="FlipHButton" Content="⇋ Miroir" ToolTip="Retourner de gauche à droite" Click="OnFx" Margin="0,0,8,0"/>
                <ToggleButton x:Name="FlipVButton" Content="⇵ Retourner" ToolTip="Retourner de haut en bas" Click="OnFx"/>
              </StackPanel>
              <TextBlock x:Name="OutSizeText" Margin="0,14,0,0"/>
              <TextBlock Text="Taille du recadrage" Style="{StaticResource Section}" Margin="0,16,0,8"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="CropWBox" Width="90" TextAlignment="Center" LostFocus="OnCropSize" KeyDown="OnCropSizeKey"/>
                <TextBlock Text="x" VerticalAlignment="Center" Margin="10,0"/>
                <TextBox x:Name="CropHBox" Width="90" TextAlignment="Center" LostFocus="OnCropSize" KeyDown="OnCropSizeKey"/>
              </StackPanel>
              <TextBlock Text="Format du recadrage" Style="{StaticResource Section}" Margin="0,16,0,8"/>
              <ComboBox x:Name="RatioBox" SelectionChanged="OnRatio">
                <ComboBoxItem Content="Libre" Tag=""/>
                <ComboBoxItem Content="Conserver l'original" Tag="orig"/>
                <ComboBoxItem Content="16:9" Tag="1.7778"/>
                <ComboBoxItem Content="4:3" Tag="1.3333"/>
                <ComboBoxItem Content="1:1" Tag="1"/>
                <ComboBoxItem Content="2,35:1 (cinémascope)" Tag="2.35"/>
                <ComboBoxItem Content="9:16 (vertical)" Tag="0.5625"/>
              </ComboBox>
              <TextBlock Text="Distance au bord (pixels)" Style="{StaticResource Section}" Margin="0,16,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Haut" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TopBox" Grid.Column="1" TextChanged="OnMargin"/>
                <TextBlock Text="Bas" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="BottomBox" Grid.Column="4" TextChanged="OnMargin"/>
                <TextBlock Text="Gauche" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="LeftBox" Grid.Row="2" Grid.Column="1" TextChanged="OnMargin"/>
                <TextBlock Text="Droite" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="RightBox" Grid.Row="2" Grid.Column="4" TextChanged="OnMargin"/>
              </Grid>
              <TextBlock Text="Tirez le cadre sur l'image de gauche, ses coins ou ses bords. La partie gardée est remise au format du disque, avec des bandes noires si besoin." Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Effet: colour, a look, the sound -->
      <TabItem Header="Effet" Tag="effect">
        <DockPanel Margin="4,10,4,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Par défaut" Click="OnDefault" Tag="effect" Margin="0,0,8,0"/>
            <Button Content="Appliquer à tous" Click="OnApplyAll" Tag="effect"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="Luminosité" Style="{StaticResource Label}"/>
              <Grid Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Slider x:Name="BrightSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                <TextBox Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" Text="{Binding Value, ElementName=BrightSlider}"/></Grid>
              <TextBlock Text="Contraste" Style="{StaticResource Label}"/>
              <Grid Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                <TextBox Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" Text="{Binding Value, ElementName=ContrastSlider}"/></Grid>
              <TextBlock Text="Saturation" Style="{StaticResource Label}"/>
              <Grid Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                <TextBox Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" Text="{Binding Value, ElementName=SaturationSlider}"/></Grid>
              <TextBlock Text="Balance des blancs (froid ← → chaud)" Style="{StaticResource Label}"/>
              <Grid Margin="0,2,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Slider x:Name="WhiteSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                <TextBox Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" Text="{Binding Value, ElementName=WhiteSlider}"/></Grid>
              <ListBox x:Name="LookList" Height="190" SelectionChanged="OnFx" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource InsetBrush}">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              </ListBox>
              <TextBlock Text="Volume" Style="{StaticResource Section}" Margin="0,14,0,0"/>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Slider x:Name="VolumeSlider" Minimum="10" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="50" ValueChanged="OnVolume"/>
                <TextBlock x:Name="VolumeText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="100 % laisse le son tel quel. Un autre volume refait le son en AC-3." Style="{StaticResource Label}" Margin="0,4,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Filigrane: a text or a picture over the video -->
      <TabItem Header="Filigrane" Tag="watermark">
        <DockPanel Margin="4,10,4,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Par défaut" Click="OnDefault" Tag="watermark" Margin="0,0,8,0"/>
            <Button Content="Appliquer à tous" Click="OnApplyAll" Tag="watermark"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="WmTextRadio" GroupName="wm" Content="Texte" Checked="OnWmKind" Margin="0,0,24,0"/>
                <RadioButton x:Name="WmPicRadio" GroupName="wm" Content="Image" Checked="OnWmKind"/>
              </StackPanel>
              <StackPanel x:Name="WmTextPanel" Margin="0,10,0,0">
                <TextBox x:Name="WmTextBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnFx"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="WmFontBox" SelectionChanged="OnFx"/>
                  <ComboBox x:Name="WmSizeBox" Grid.Column="1" Margin="6,0,0,0" IsEditable="True" SelectionChanged="OnFx" LostFocus="OnFx"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                    <ToggleButton x:Name="WmBold" Content="G" FontWeight="Bold" Width="40" Padding="0" ToolTip="Gras" Click="OnFx"/>
                    <ToggleButton x:Name="WmItalic" Content="I" FontStyle="Italic" Width="40" Padding="0" Margin="4,0" ToolTip="Italique" Click="OnFx"/>
                    <ToggleButton x:Name="WmUnderline" Width="40" Padding="0" ToolTip="Souligné" Click="OnFx"><TextBlock Text="S" TextDecorations="Underline"/></ToggleButton>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Couleur" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <ComboBox x:Name="WmColorBox" SelectionChanged="OnFx"/>
              </StackPanel>
              <StackPanel x:Name="WmPicPanel" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="WmPicText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                  <Button Grid.Column="1" Content="Choisir une image…" Click="OnWmPicture" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="Largeur (part de l'image)" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                  <Slider x:Name="WmWidthSlider" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                  <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=WmWidthSlider, StringFormat={}{0} %}"/></Grid>
              </StackPanel>
              <TextBlock Text="Transparence" Style="{StaticResource Label}" Margin="0,12,0,2"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Slider x:Name="WmTransSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=WmTransSlider, StringFormat={}{0} %}"/></Grid>
              <TextBlock Text="Position" Style="{StaticResource Label}" Margin="0,10,0,2"/>
              <ComboBox x:Name="WmPlaceBox" SelectionChanged="OnFx">
                <ComboBoxItem Content="En haut à gauche" Tag="tl"/>
                <ComboBoxItem Content="En haut à droite" Tag="tr"/>
                <ComboBoxItem Content="En bas à gauche" Tag="bl"/>
                <ComboBoxItem Content="En bas à droite" Tag="br"/>
                <ComboBoxItem Content="Au centre" Tag="c"/>
              </ComboBox>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Sous-titres: one text subtitle drawn into the picture -->
      <TabItem Header="Sous-titres" Tag="subtitle">
        <DockPanel Margin="4,10,4,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Par défaut" Click="OnDefault" Tag="subtitle" Margin="0,0,8,0"/>
            <Button Content="Appliquer à tous" Click="OnApplyAll" Tag="subtitle"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="Incruster des sous-titres dans l'image (toujours affichés, même sans réglage du lecteur)." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="BurnBox" SelectionChanged="OnBurnPick"/>
                <Button Grid.Column="1" Content="+ Ajouter des sous-titres" Click="OnBurnAdd" Margin="8,0,0,0"/>
              </Grid>
              <StackPanel x:Name="BurnPanel">
                <TextBlock Text="Police" Style="{StaticResource Label}" Margin="0,12,0,2"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="BurnFontBox" SelectionChanged="OnFx"/>
                  <ComboBox x:Name="BurnSizeBox" Grid.Column="1" Margin="6,0,0,0" IsEditable="True" SelectionChanged="OnFx" LostFocus="OnFx"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                    <ToggleButton x:Name="BurnBold" Content="G" FontWeight="Bold" Width="40" Padding="0" ToolTip="Gras" Click="OnFx"/>
                    <ToggleButton x:Name="BurnItalic" Content="I" FontStyle="Italic" Width="40" Padding="0" Margin="4,0,0,0" ToolTip="Italique" Click="OnFx"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Couleur" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <ComboBox x:Name="BurnColorBox" SelectionChanged="OnFx"/>
                <TextBlock Text="Transparence" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                  <Slider x:Name="BurnTransSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                  <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=BurnTransSlider, StringFormat={}{0} %}"/></Grid>
                <TextBlock Text="Position" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Bas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Slider x:Name="BurnPosSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFx"/>
                  <TextBlock Text="Centre" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
                <TextBlock Text="Délai (secondes, négatif = plus tôt)" Style="{StaticResource Label}" Margin="0,10,0,2"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                  <Slider x:Name="BurnDelaySlider" Minimum="-30" Maximum="30" TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="1" ValueChanged="OnFx"/>
                  <TextBox Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" Text="{Binding Value, ElementName=BurnDelaySlider, StringFormat=0.0}"/></Grid>
              </StackPanel>
              <TextBlock Text="Les pistes de sous-titres à choisir sur le lecteur se règlent dans la liste des vidéos." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Chapitres: the part kept and the chapter marks -->
      <TabItem Header="Chapitres" Tag="chapters">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,0">
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Clips de sortie" Style="{StaticResource Section}" Margin="0,0,0,0"/>
            <TextBlock Text="Les parties de la vidéo gardées sur le disque, dans l'ordre : ce qui se trouve entre deux clips est enlevé." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <StackPanel x:Name="ClipPanel" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Couper ici" Click="OnSplitClip" ToolTip="Partage le clip en deux à la position de l'aperçu ; supprimez ensuite la partie à enlever"/>
              <Button Content="+ Ajouter un clip" Click="OnAddClip" Margin="8,0,0,0" ToolTip="Un clip d'une minute à la position de l'aperçu"/>
              <Button Content="Toute la vidéo" Click="OnClipsDefault" Margin="8,0,0,0" ToolTip="Un seul clip, du début à la fin du fichier"/>
            </StackPanel>
            <TextBlock x:Name="KeptText" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Chapitres" Style="{StaticResource Section}"/>
            <RadioButton x:Name="ChapDisc" GroupName="chapters" Margin="0,8,0,0" Checked="OnChapterMode"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <RadioButton x:Name="ChapEvery" GroupName="chapters" Content="Un chapitre toutes les" VerticalAlignment="Center" Checked="OnChapterMode"/>
              <TextBox x:Name="EveryBox" Width="50" Margin="8,0,8,0" TextAlignment="Center"/>
              <TextBlock Text="minutes" Style="{StaticResource Label}" VerticalAlignment="Center"/>
              <Button Content="Insertion automatique" Margin="12,0,0,0" Click="OnAutoInsert" ToolTip="Remplit la liste personnalisée avec un chapitre toutes les N minutes, à retoucher ensuite"/>
            </StackPanel>
            <RadioButton x:Name="ChapNone" GroupName="chapters" Content="Sortie sans chapitres" Margin="0,10,0,0" Checked="OnChapterMode"/>
            <RadioButton x:Name="ChapCustom" GroupName="chapters" Content="Liste personnalisée (temps dans la vidéo d'origine)" Margin="0,10,0,0" Checked="OnChapterMode"/>
            <Grid x:Name="ListPanel" Margin="24,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ListBox x:Name="ChapterList" Height="150" SelectionMode="Extended"/>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="150">
                <TextBox x:Name="AtBox" ToolTip="h:mm:ss (ou en secondes)"/>
                <Button Content="Insérer" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="OnInsert"/>
                <Button Content="Insérer ici" ToolTip="Un chapitre à la position de l'aperçu" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="OnInsertHere"/>
                <Button Content="Supprimer" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="OnDelete"/>
                <Button Content="Tout supprimer" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="OnDeleteAll"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Les chapitres en dehors de la partie gardée sont ignorés." Style="{StaticResource Label}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk" Style="{StaticResource Primary}"/>
      <Button Content="Annuler" IsCancel="True" MinWidth="90"/>
    </StackPanel>
  </Grid>
</Window>
