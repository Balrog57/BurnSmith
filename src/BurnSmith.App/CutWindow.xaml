<Window x:Class="BurnSmith.App.CutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Couper" Width="1080" Height="780" MinWidth="1000" MinHeight="560"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Time" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="96"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="h:mm:ss (Entrée pour valider)"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16,12,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- the picture at the playhead; while playing, ffmpeg's frames -->
    <Grid Background="Black">
      <Image x:Name="Screen" Stretch="Uniform"/>
      <TextBlock x:Name="PosText" Foreground="White" Margin="40,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10" Padding="0,24,0,8">
      <StackPanel>
        <UniformGrid x:Name="Strip" Rows="1" Height="76" Background="{StaticResource InsetBrush}" MouseLeftButtonDown="OnStripClick" Cursor="Hand"/>
        <Canvas x:Name="Ruler" Height="20" ClipToBounds="True"/>
        <!-- the kept part between its two handles, and the playhead; a click or a drag moves the nearest -->
        <Canvas x:Name="Track" Height="18" Background="Transparent" Margin="4,0" Cursor="Hand" SizeChanged="OnTrackSize"
                MouseLeftButtonDown="OnTrackDown" MouseMove="OnTrackMove" MouseLeftButtonUp="OnTrackUp">
          <Rectangle x:Name="Rail" Height="4" Canvas.Top="7" Fill="{StaticResource LineBrush}"/>
          <Rectangle x:Name="Kept" Height="4" Canvas.Top="7" Fill="{StaticResource AccentBrush}"/>
          <Rectangle x:Name="StartHandle" Width="6" Height="18" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentHoverBrush}"/>
          <Rectangle x:Name="EndHandle" Width="6" Height="18" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentHoverBrush}"/>
          <Rectangle x:Name="Playhead" Width="2" Height="18" Fill="White"/>
        </Canvas>

        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
          <Button Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="Aller au début de la partie gardée" Click="OnToStart"/>
          <Button x:Name="PlayButton" Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="Lecture / pause (sans le son)" Click="OnPlay"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Aller à la fin de la partie gardée" Click="OnToEnd"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Margin="14,0,0,0" ToolTip="Une seconde plus tôt" Click="OnStep" Tag="pos:-1"/>
          <TextBox x:Name="PosBox" Style="{StaticResource Time}" PreviewKeyDown="OnTimeKey" LostFocus="OnTimeEdited"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE710;" ToolTip="Une seconde plus tard" Click="OnStep" Tag="pos:1"/>
          <TextBlock x:Name="TotalText" VerticalAlignment="Center" Margin="6,0,0,0"/>
          <TextBlock Text="Heure de début :" VerticalAlignment="Center" Margin="22,0,6,0"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Click="OnStep" Tag="start:-1"/>
          <TextBox x:Name="StartBox" Style="{StaticResource Time}" PreviewKeyDown="OnTimeKey" LostFocus="OnTimeEdited"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Click="OnStep" Tag="start:1"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE7B7;" ToolTip="Début ici (à la tête de lecture)" Click="OnMark" Tag="start"/>
          <TextBlock Text="Heure de fin :" VerticalAlignment="Center" Margin="16,0,6,0"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE738;" Click="OnStep" Tag="end:-1"/>
          <TextBox x:Name="EndBox" Style="{StaticResource Time}" PreviewKeyDown="OnTimeKey" LostFocus="OnTimeEdited"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE710;" Click="OnStep" Tag="end:1"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE7B7;" ToolTip="Fin ici (à la tête de lecture)" Click="OnMark" Tag="end"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="KeptText" VerticalAlignment="Center" Opacity="0.75"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="OK" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk" Style="{StaticResource Primary}"/>
        <Button Content="Annuler" IsCancel="True" MinWidth="90"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
