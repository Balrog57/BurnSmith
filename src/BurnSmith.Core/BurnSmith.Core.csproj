<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- the BD-J menu xlet travels inside the assembly so the single-file exe needs no assets folder -->
    <EmbeddedResource Include="..\..\assets\bdj\menu.jar" LogicalName="assets/bdj/menu.jar" />
    <!-- open-source menu templates and pictures (DVDStyler, GPL) with their notices; unpacked on first use by OpenLibrary -->
    <EmbeddedResource Include="..\..\assets\library\**\*" LogicalName="library/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
  </ItemGroup>

</Project>
